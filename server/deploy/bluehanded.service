# systemd unit: starts the Blue-Handed server at boot and restarts it if it crashes.
# Installed by deploy/install_pi.sh to /etc/systemd/system/bluehanded.service
[Unit]
Description=Blue-Handed exam hall BLE monitoring server
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=BLUEHANDED_CONFIG=__DIR__/config.toml
ExecStart=__DIR__/.venv/bin/python -m bluehanded serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
